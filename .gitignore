# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Claude Code's local, machine-specific permissions.
.claude/settings.local.json

# Python
__pycache__/
*.pyc

# PyInstaller build output — `build/` is pure intermediate cache, and the
# .exe itself isn't committed either.
/build/
*.exe

# The presentation page doesn't belong in the app's history, same as
# Shelf's site living in its own separate repo, not gamebrowser's.
/site/
